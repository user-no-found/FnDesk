#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091
source /etc/default/fndesk

KIOSK_HOME="$(getent passwd "${KIOSK_USER}" | cut -d: -f6)"
if [[ -z "${KIOSK_HOME}" || ! -d "${KIOSK_HOME}" ]]; then
  echo "FnDesk local display: cannot resolve home directory for ${KIOSK_USER}." >&2
  exit 75
fi

export HOME="${KIOSK_HOME}"
export USER="${KIOSK_USER}"
export LOGNAME="${KIOSK_USER}"
export SHELL="$(getent passwd "${KIOSK_USER}" | cut -d: -f7)"
export XDG_RUNTIME_DIR="/run/fndesk-local"
export LIBSEAT_BACKEND=seatd
export WLR_LIBINPUT_NO_DEVICES=1
export WLR_NO_HARDWARE_CURSORS=1
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export INPUT_METHOD=fcitx
export SDL_IM_MODULE=fcitx
export LANG=zh_CN.UTF-8
export LANGUAGE=zh_CN:zh
export LC_ALL=zh_CN.UTF-8
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

if [[ "${FNDESK_DRM_LEGACY:-1}" == "1" ]]; then
  export WLR_DRM_NO_ATOMIC=1
fi
if [[ "${FNDESK_DRM_NO_MODIFIERS:-1}" == "1" ]]; then
  export WLR_DRM_NO_MODIFIERS=1
fi
if [[ "${FNDESK_USE_SYSTEM_LIBDRM:-1}" == "1" && -d /usr/lib/x86_64-linux-gnu ]]; then
  export LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi
if [[ "${FNDESK_SOFTWARE_RENDERER:-1}" == "1" ]]; then
  # Mesa 22 does not recognize the Strix GPU on affected fnOS releases. Use
  # wlroots' native pixman renderer so Cage never probes AMD/NVIDIA EGL devices.
  export WLR_RENDERER=pixman
fi

select_drm_device() {
  local candidate
  local card
  local connector

  if [[ -n "${FNDESK_DRM_DEVICE:-}" && -c "${FNDESK_DRM_DEVICE}" ]]; then
    printf '%s\n' "${FNDESK_DRM_DEVICE}"
    return 0
  fi

  if [[ -n "${KIOSK_OUTPUT:-}" ]]; then
    for connector in /sys/class/drm/card*-"${KIOSK_OUTPUT}"; do
      [[ -e "${connector}" ]] || continue
      card="${connector##*/}"
      card="${card%%-*}"
      if [[ -c "/dev/dri/${card}" ]]; then
        printf '%s\n' "/dev/dri/${card}"
        return 0
      fi
    done
  fi

  # Select a card that exposes physical connector entries. Glob expansion
  # checks directory entries only: never read connector status content here,
  # because that read can block after a KMS failure.
  for candidate in /sys/class/drm/card[0-9]*; do
    [[ -e "${candidate}" ]] || continue
    card="${candidate##*/}"
    [[ "${card}" =~ ^card[0-9]+$ ]] || continue
    compgen -G "/sys/class/drm/${card}-*/status" >/dev/null || continue
    if [[ -c "/dev/dri/${card}" ]]; then
      printf '%s\n' "/dev/dri/${card}"
      return 0
    fi
  done

  return 1
}

if ! drm_device="$(select_drm_device)"; then
  echo "FnDesk local display: no DRM card with display connectors was found." >&2
  exit 75
fi
export WLR_DRM_DEVICES="${drm_device}"
echo "FnDesk local display: using DRM device ${WLR_DRM_DEVICES}." >&2

export FNDESK_CHILD_STATUS_FILE="${XDG_RUNTIME_DIR}/child-exit-status"
rm -f "${FNDESK_CHILD_STATUS_FILE}"

set +e
dbus-run-session -- cage -m last -- /usr/local/bin/fndesk-local-browser
cage_status=$?
set -e

# Cage 0.1.4 can remain alive after its application exits when there is no
# output. The browser wrapper records the real reason before terminating Cage;
# propagate that status to systemd instead of reporting a false active service.
if [[ -f "${FNDESK_CHILD_STATUS_FILE}" ]]; then
  child_status="$(head -n 1 "${FNDESK_CHILD_STATUS_FILE}" 2>/dev/null || true)"
  rm -f "${FNDESK_CHILD_STATUS_FILE}"
  if [[ "${child_status}" =~ ^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$ ]]; then
    exit "${child_status}"
  fi
fi

exit "${cage_status}"
