[Unit]
Description=FnDesk Local Microsoft Edge
After=systemd-user-sessions.service network-online.target seatd.service
Wants=network-online.target
Conflicts=getty@tty1.service seatd.service

[Service]
Type=simple
EnvironmentFile=/etc/default/fndesk
User=root
ExecStartPre=/usr/bin/install -d -o ${KIOSK_USER} -g ${KIOSK_GROUP} -m 0700 /run/fndesk-local
ExecStartPre=/usr/local/bin/fndesk-seatd-socket-guard
# seatd-launch requires effective root to start seatd and a real kiosk UID/GID
# so it can chown the private socket and drop the target's privileges. setpriv
# supplies exactly that split without installing a setuid binary.
ExecStart=/usr/bin/setpriv --ruid=${KIOSK_USER} --euid=0 --rgid=${KIOSK_GROUP} --egid=0 --init-groups /usr/bin/seatd-launch -- /usr/local/bin/fndesk-local-launch
ExecStopPost=/usr/bin/rm -rf /run/fndesk-local
Restart=no
SuccessExitStatus=75
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=control-group
TTYPath=/dev/tty1
# Keep a controlling VT for seatd, but never ask PID 1 to reset or vhangup it:
# both operations can enter console_lock while DRM is being restored.
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
