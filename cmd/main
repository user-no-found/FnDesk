#!/bin/bash
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PKG_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)
APP_DEST=""
for candidate in \
    "${TRIM_APPDEST:-}" \
    "${TRIM_APPDEST:-}/app" \
    "${PKG_ROOT}" \
    "${PKG_ROOT}/app"
do
    if [ -n "${candidate}" ] && [ -f "${candidate}/server/fndesk-server.py" ]; then
        APP_DEST="${candidate}"
        break
    fi
done
if [ -z "${APP_DEST}" ]; then
    APP_DEST="${TRIM_APPDEST:-${PKG_ROOT}}"
fi
PKG_VAR="${TRIM_PKGVAR:-${PKG_ROOT}/var}"
LOG_FILE="${PKG_VAR}/fndesk.log"
PORT="${TRIM_SERVICE_PORT:-18733}"
CONTROL_PID_FILE="${PKG_VAR}/fndesk-control.pid"

log_msg() {
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

control_pid_alive() {
    local file="$1"
    local pid=""
    if [ -f "${file}" ]; then
        pid=$(head -n 1 "${file}" | tr -d '[:space:]')
        if check_process "${pid}" && tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q 'fndesk-server.py'; then
            return 0
        fi
        rm -f "${file}" 2>/dev/null || true
    fi
    return 1
}

stop_pid_file() {
    local file="$1"
    local pid=""
    if [ -f "${file}" ]; then
        pid=$(head -n 1 "${file}" | tr -d '[:space:]')
        if check_process "${pid}" && tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q 'fndesk-server.py'; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
            sleep 1
            if check_process "${pid}"; then
                kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1 || true
            fi
        fi
        rm -f "${file}"
    fi
}

status_process() {
    control_pid_alive "${CONTROL_PID_FILE}"
}

stop_process() {
    mkdir -p "${PKG_VAR}"
    log_msg "Stopping FnDesk control console."
    stop_pid_file "${CONTROL_PID_FILE}"
}

start_process() {
    if status_process; then
        log_msg "FnDesk control console is already running."
        return 0
    fi

    mkdir -p "${PKG_VAR}"
    log_msg "Starting FnDesk control console on 0.0.0.0:${PORT}."
    TRIM_APPDEST="${APP_DEST}" TRIM_PKGVAR="${PKG_VAR}" TRIM_SERVICE_PORT="${PORT}" \
        nohup python3 "${APP_DEST}/server/fndesk-server.py" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${CONTROL_PID_FILE}"
    sleep 1
    control_pid_alive "${CONTROL_PID_FILE}"
}

case "${1:-}" in
start) start_process ;;
stop) stop_process ;;
status) status_process ;;
restart) stop_process; start_process ;;
*) exit 1 ;;
esac
