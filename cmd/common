#!/bin/bash

RM="/bin/rm -rf"
MKDIR="/bin/mkdir -p"

install_log()
{
    local _msg_="$@"
    if [ -z "${_msg_}" ]; then
        while IFS=$'\n' read -r line; do
            install_log "${line}"
        done
    else
        echo -e "$(date +'%Y/%m/%d %H:%M:%S')\t${_msg_}" 1>&2
    fi
}

log_step()
{
    install_log "===> Step $1. STATUS=${TRIM_APP_STATUS} APPDEST=${TRIM_APPDEST} PKGVAR=${TRIM_PKGVAR}"
}

is_upgrade_flow()
{
    case "$(printf '%s' "${TRIM_APP_STATUS}" | tr '[:lower:]' '[:upper:]')" in
        *UPGRADE*|*UPDATE*) return 0 ;;
        *) return 1 ;;
    esac
}

volume_root()
{
    case "${TRIM_PKGVAR}" in
        /*/@appdata/*) printf '%s' "${TRIM_PKGVAR%%/@appdata/*}"; return 0 ;;
    esac
    case "${TRIM_APPDEST}" in
        /*/@appcenter/*) printf '%s' "${TRIM_APPDEST%%/@appcenter/*}"; return 0 ;;
    esac
    return 1
}

payload_script()
{
    local script_name="$1"
    local path
    for path in \
        "${TRIM_APPDEST}/${script_name}" \
        "${TRIM_APPDEST}/app/${script_name}" \
        "${TRIM_PKGVAR}/payload/${script_name}" \
        "${TRIM_PKGVAR}/payload/app/${script_name}"
    do
        if [ -x "${path}" ]; then
            printf '%s' "${path}"
            return 0
        fi
    done

    if [ -f "${TRIM_APPDEST}/app.tgz" ]; then
        $MKDIR "${TRIM_PKGVAR}/payload"
        tar -xzf "${TRIM_APPDEST}/app.tgz" -C "${TRIM_PKGVAR}/payload"
        for path in \
            "${TRIM_PKGVAR}/payload/${script_name}" \
            "${TRIM_PKGVAR}/payload/app/${script_name}"
        do
            if [ -x "${path}" ]; then
                printf '%s' "${path}"
                return 0
            fi
        done
    fi

    return 1
}

default_kiosk_user()
{
    if [ -n "${KIOSK_USER:-}" ]; then
        printf '%s' "${KIOSK_USER}"
        return 0
    fi

    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $6 ~ /^\// && $7 !~ /(nologin|false)$/ { print $1; exit }'
}

stop_runtime()
{
    pkill -TERM -f 'Xvnc :99 .*fndesk' 2>/dev/null || true
    pkill -TERM -f 'vncconfig -nowin' 2>/dev/null || true
    pkill -TERM -f 'fndesk-window-sync-99' 2>/dev/null || true
    pkill -TERM -f 'microsoft-edge-stable .*fndesk.*/web-edge-profile' 2>/dev/null || true
    pkill -TERM -f 'fcitx5.*fndesk-web-runtime' 2>/dev/null || true
    pkill -TERM -f 'websockify .*18733' 2>/dev/null || true
    rm -rf /tmp/fndesk-web-runtime-* 2>/dev/null || true
    rm -rf /var/tmp/fndesk-web-runtime-* 2>/dev/null || true
}

stop_all_runtime()
{
    systemctl disable --now web-kiosk.service 2>/dev/null || true
    systemctl disable --now web-kiosk-display-power.service 2>/dev/null || true
    stop_runtime
}

load_web_kiosk_config()
{
    KIOSK_USER=""
    KIOSK_OUTPUT=""
    FNDESK_INSTALLED_PACKAGES=""
    FNDESK_CREATED_EDGE_KEY="0"
    FNDESK_CREATED_EDGE_REPO="0"

    if [ -f /etc/default/web-kiosk ]; then
        # shellcheck disable=SC1091
        . /etc/default/web-kiosk
    fi
}

clean_user_data()
{
    if [ "${wizard_delete_data:-false}" != "true" ]; then
        install_log "user profile cleanup skipped"
        return 0
    fi

    load_web_kiosk_config

    local kiosk_user="${KIOSK_USER:-}"
    local kiosk_home=""

    if [ -z "${kiosk_user}" ]; then
        kiosk_user="$(default_kiosk_user)"
    fi

    if [ -n "${kiosk_user}" ] && id "${kiosk_user}" >/dev/null 2>&1; then
        kiosk_home="$(getent passwd "${kiosk_user}" | cut -d: -f6)"
        if [ -n "${kiosk_home}" ]; then
            install_log "removing Web Edge profile: ${kiosk_home}/.local/share/fndesk"
            rm -rf "${kiosk_home}/.local/share/fndesk" 2>/dev/null || true
        fi
    fi
}

is_removable_package()
{
    case "$1" in
        cage|microsoft-edge-stable|seatd|wlr-randr|xwayland|mesa-utils|fonts-noto-cjk|adwaita-icon-theme|\
        fcitx5|fcitx5-chinese-addons|fcitx5-frontend-gtk3|fcitx5-frontend-gtk4|fcitx5-frontend-qt5|\
        tigervnc-common|tigervnc-standalone-server|tigervnc-tools|novnc|websockify|x11-utils|xdotool|xclip)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

fndesk_dependency_packages()
{
    printf '%s\n' \
        cage \
        microsoft-edge-stable \
        seatd \
        wlr-randr \
        xwayland \
        mesa-utils \
        fonts-noto-cjk \
        adwaita-icon-theme \
        fcitx5 \
        fcitx5-chinese-addons \
        fcitx5-frontend-gtk3 \
        fcitx5-frontend-gtk4 \
        fcitx5-frontend-qt5 \
        tigervnc-common \
        tigervnc-standalone-server \
        tigervnc-tools \
        novnc \
        websockify \
        x11-utils \
        xdotool \
        xclip
}

clean_dependency_packages()
{
    if [ "${wizard_remove_packages:-false}" != "true" ]; then
        install_log "dependency package removal skipped"
        return 0
    fi

    load_web_kiosk_config

    local packages=()
    local package=""

    while IFS= read -r package; do
        if is_removable_package "${package}"; then
            packages+=("${package}")
        fi
    done < <(fndesk_dependency_packages)

    if [ "${#packages[@]}" -eq 0 ]; then
        install_log "no FnDesk dependency packages selected for removal"
    else
        install_log "purging FnDesk dependency packages: ${packages[*]}"
        DEBIAN_FRONTEND=noninteractive apt-get purge -y "${packages[@]}" 2>&1 | install_log || true
        dpkg --purge "${packages[@]}" 2>&1 | install_log || true
    fi

    install_log "purging orphaned dependency packages"
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y 2>&1 | install_log || true

    rm -f /etc/apt/sources.list.d/microsoft-edge.list 2>/dev/null || true
    rm -f /etc/apt/sources.list.d/microsoft-edge.sources 2>/dev/null || true
    rm -f /etc/apt/keyrings/microsoft.gpg 2>/dev/null || true
}

clean_system_files()
{
    local kiosk_user=""
    local kiosk_home=""

    load_web_kiosk_config
    kiosk_user="${KIOSK_USER:-}"

    stop_all_runtime

    if [ -n "${kiosk_user}" ] && id "${kiosk_user}" >/dev/null 2>&1; then
        kiosk_home="$(getent passwd "${kiosk_user}" | cut -d: -f6)"
        if [ -n "${kiosk_home}" ] && [ -f "${kiosk_home}/.bashrc" ]; then
            sed -i '/^alias fnre=/d' "${kiosk_home}/.bashrc" 2>/dev/null || true
            sed -i '/^alias fndesk-restart=/d' "${kiosk_home}/.bashrc" 2>/dev/null || true
        fi
    fi

    rm -f /etc/systemd/system/web-kiosk.service 2>/dev/null || true
    rm -f /etc/systemd/system/web-kiosk-display-power.service 2>/dev/null || true
    rm -f /usr/local/bin/web-kiosk-launch 2>/dev/null || true
    rm -f /usr/local/bin/web-kiosk-browser 2>/dev/null || true
    rm -f /usr/local/bin/web-kiosk-display-power 2>/dev/null || true
    rm -f /etc/default/web-kiosk 2>/dev/null || true
    rm -rf /etc/web-kiosk 2>/dev/null || true
    rm -f /etc/opt/edge/policies/managed/web-kiosk.json 2>/dev/null || true
    rm -f /etc/systemd/logind.conf.d/web-kiosk.conf 2>/dev/null || true
    rm -f /etc/systemd/sleep.conf.d/web-kiosk.conf 2>/dev/null || true
    rm -f /etc/udev/rules.d/99-web-kiosk-drm.rules 2>/dev/null || true
    rm -rf /run/web-kiosk 2>/dev/null || true

    systemctl daemon-reload 2>/dev/null || true
    udevadm control --reload-rules 2>/dev/null || true
    systemctl unmask sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target 2>/dev/null || true
    systemctl restart systemd-logind.service 2>/dev/null || true
    systemctl enable --now getty@tty1.service 2>/dev/null || true
}

clean_app_dirs()
{
    local appname="${TRIM_APPNAME:-fndesk}"
    local volume=""

    rm -f "${TRIM_PKGVAR}/.upgrading" 2>/dev/null || true
    rm -rf "${TRIM_PKGVAR}/payload" 2>/dev/null || true

    if volume="$(volume_root)" && [ -n "${appname}" ]; then
        rm -rf "${volume}/@appshare/${appname}" 2>/dev/null || true
        rm -rf "${volume}/@appcenter/${appname}" 2>/dev/null || true
        rm -rf "${volume}/@appdata/${appname}" 2>/dev/null || true
        rm -rf "${volume}/@appmeta/${appname}" 2>/dev/null || true
    fi

    if [ -n "${appname}" ]; then
        rm -rf "/var/apps/${appname}" 2>/dev/null || true
        rm -rf "/var/apps_ui/${appname}" 2>/dev/null || true
        rm -rf "/usr/local/apps/@appcenter/${appname}" 2>/dev/null || true
        rm -rf "/usr/local/apps/@appdata/${appname}" 2>/dev/null || true
        rm -rf "/usr/local/apps/@appconf/${appname}" 2>/dev/null || true
        rm -rf "/usr/local/apps/@apphome/${appname}" 2>/dev/null || true
        rm -rf "/usr/local/apps/@appmeta/${appname}" 2>/dev/null || true
        rm -f "/var/log/apps/${appname}.log" 2>/dev/null || true
        rm -f "/var/log/apps/${appname}.log-"*.gz 2>/dev/null || true
    fi
}

install_init()
{
    log_step "install_init"
    if ! is_upgrade_flow; then
        rm -f "${TRIM_PKGVAR}/.upgrading"
    fi
    exit 0
}

install_callback()
{
    log_step "install_callback"
    if ! is_upgrade_flow; then
        rm -f "${TRIM_PKGVAR}/.upgrading"
    fi

    $MKDIR "${TRIM_PKGVAR}"

    local installer=""
    if ! installer="$(payload_script install-kiosk.sh)"; then
        install_log "install-kiosk.sh not found in ${TRIM_APPDEST}"
        exit 1
    fi

    local kiosk_user=""
    kiosk_user="$(default_kiosk_user)"
    if [ -z "${kiosk_user}" ]; then
        install_log "no regular login user found; set KIOSK_USER before installing"
        exit 1
    fi

    KIOSK_USER="${kiosk_user}" "${installer}" 2>&1 | install_log
    local install_status=${PIPESTATUS[0]}
    if [ "${install_status}" -ne 0 ]; then
        install_log "install-kiosk.sh failed with exit code ${install_status}"
        exit "${install_status}"
    fi

    systemctl start web-kiosk.service 2>&1 | install_log || true
    install_log "FnDesk install completed"
    exit 0
}

uninstall_init()
{
    log_step "uninstall_init"
    stop_runtime
    exit 0
}

uninstall_callback()
{
    log_step "uninstall_callback"

    if is_upgrade_flow; then
        install_log "upgrade flow detected; skipping full data cleanup"
        exit 0
    fi

    clean_user_data
    clean_dependency_packages

    clean_system_files

    clean_app_dirs

    install_log "FnDesk uninstall cleanup completed"
    exit 0
}

upgrade_init()
{
    log_step "upgrade_init"
    $MKDIR "${TRIM_PKGVAR}"
    date +%s > "${TRIM_PKGVAR}/.upgrading"
    stop_runtime
    exit 0
}

upgrade_callback()
{
    log_step "upgrade_callback"
    rm -f "${TRIM_PKGVAR}/.upgrading"
    install_log "FnDesk upgrade completed"
    exit 0
}
